{
  "name": "minnan-orthography-extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:vendor && npm run build:dictionary",
    "build:vendor": "cp node_modules/fflate/umd/index.js vendor/fflate.js",
