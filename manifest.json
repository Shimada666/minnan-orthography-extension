{
  "manifest_version": 3,
  "name": "台字帖",
  "version": "0.1.0",
  "description": "选中词语，查询教育部臺灣台語常用詞辭典的读音和释义。",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vendor/fflate.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/kautian.ods"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
